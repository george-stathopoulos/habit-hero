{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "habit-hero-cloudflare",
  "main": "./worker.mjs",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../cloudflare-dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api", "/api/*", "/_health"],
    "not_found_handling": "single-page-application"
  }
}
