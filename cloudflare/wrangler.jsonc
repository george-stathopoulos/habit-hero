{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "habit-hero-cloudflare",
  "main": "./worker.mjs",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../cloudflare-dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/api",
      "/api/*",
      "/habit-hero/v2/*",
      "/habit-hero/v2",
      "/habit-hero/welcome/v2/*",
      "/_health"
    ],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "habit-hero-db",
      "database_id": "0450de33-0812-45b4-8f52-62ed9947aaf3"
    }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "375981700231-lrhrp78kndrq2dbnpummj32kaapgu9e9.apps.googleusercontent.com"
  }
}
